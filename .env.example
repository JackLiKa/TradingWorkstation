# ===== 应用 =====
APP_TITLE=量化交易工作台

# ===== 数据库 (MySQL) =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=a_stock_baostock
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ===== 查询默认值 =====
DEFAULT_ADJUSTFLAG=3
DEFAULT_LIMIT=200
LOOKBACK_DAYS=180

# ===== 后端服务 =====
SERVER_PORT=8090
SERVER_CONTEXT_PATH=/TradingWorkstation
CORS_ALLOWED_ORIGINS=http://localhost:3010

# ===== API 安全 =====
# 啟用 API Key 認證（生產環境建議啟用）
SECURITY_ENABLED=false
# API Key（SECURITY_ENABLED=true 時必填，前端和 Agent 需在請求頭注入 X-API-Key）
API_KEY=

# ===== 缓存 =====
CACHE_SUMMARY_TTL_SECONDS=60
CACHE_METRICS_TTL_SECONDS=30

# ===== 監控 (Prometheus + Grafana，docker-compose 可選) =====
GRAFANA_PASSWORD=

# ===== 用户偏好 =====
# preference.json 路径（相对路径基于 user.dir，绝对路径直接使用）
PREFERENCE_PATH=preference.json

# ===== 数据同步 (Baostock) =====
SYNC_PYTHON_EXECUTABLE=python
SYNC_INGESTION_SCRIPT=ingestion/baostock_ingest.py
SYNC_BATCH_SIZE=1000
SYNC_DEFAULT_START_DATE=2021-01-01

# ===== 通知服务 (景氣度預警推送) =====
# 总开关
NOTIFICATION_ENABLED=false
# 邮件通知 (SMTP)
MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
# Webhook 通知
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=
# 景氣度預警定時調度器（P4-8：每交易日 15:30 自動檢查並推送）
ALERT_SCHEDULER_ENABLED=false
ALERT_SCHEDULER_THRESHOLD=15.0
ALERT_SCHEDULER_CRON="0 30 15 * * MON-FRI"

# ===== Docker 部署（docker-compose 使用）=====
# 以下變量由 docker-compose.yml 讀取，部署時需配置
# DB_PASSWORD / API_KEY / GRAFANA_PASSWORD 見上方對應區塊

# LLM API Keys（Agent 服務需要，至少配置一個）
DEVIN_API_KEY=
QODER_PERSONAL_ACCESS_TOKEN=
DEEPSEEK_API_KEY=
GLM_API_KEY=
QWEN_API_KEY=

# 聊天工具 API Keys（可選）
EXA_API_KEY=
BAIDU_QIANFAN_API_KEY=

# MCP 服務（a-share-mcp 已打包進 Agent 鏡像，無需配置地址）
FTSHARE_MCP_URL=https://market.ft.tech/gateway/mcp

# 新聞自動同步（Agent 服務）
NEWS_SYNC_ENABLED=true
NEWS_SYNC_INTERVAL=360
NEWS_SYNC_CATCHUP_DAYS=7
NEWS_SYNC_CHANNELS=all
NEWS_SYNC_CATCHUP_ON_STARTUP=true

# Agent 日誌級別
LOG_LEVEL=INFO
# HuggingFace 镜像源（国内服务器需要）
HF_ENDPOINT=https://hf-mirror.com
