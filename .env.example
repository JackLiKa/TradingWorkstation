# ===== 应用 =====
APP_TITLE=量化交易工作台

# ===== 数据库 (MySQL) =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=a_stock_baostock
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ===== 查询默认值 =====
DEFAULT_ADJUSTFLAG=3
DEFAULT_LIMIT=200
LOOKBACK_DAYS=180

# ===== 后端服务 =====
SERVER_PORT=8090
SERVER_CONTEXT_PATH=/TradingWorkstation
CORS_ALLOWED_ORIGINS=http://localhost:3010

# ===== 缓存 =====
CACHE_SUMMARY_TTL_SECONDS=60
CACHE_METRICS_TTL_SECONDS=30

# ===== 数据同步 (Baostock) =====
SYNC_PYTHON_EXECUTABLE=python
SYNC_INGESTION_SCRIPT=ingestion/baostock_ingest.py
SYNC_BATCH_SIZE=1000
SYNC_DEFAULT_START_DATE=2021-01-01

# ===== 通知服务 (景氣度預警推送) =====
# 总开关
NOTIFICATION_ENABLED=false
# 邮件通知 (SMTP)
MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
# Webhook 通知
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=
