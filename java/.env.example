# ===== Java 後端環境變量 =====
# 用法: 複製此文件為 .env 並填寫實際值
# start.ps1 會自動加載此文件（優先）或根目錄 .env（降級）

# ===== 应用 =====
APP_TITLE=量化交易工作台

# ===== 数据库 (MySQL) =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=a_stock_baostock
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ===== 查询默认值 =====
DEFAULT_ADJUSTFLAG=3
DEFAULT_LIMIT=200
LOOKBACK_DAYS=180

# ===== 后端服务 =====
SERVER_PORT=8090
SERVER_CONTEXT_PATH=/TradingWorkstation
CORS_ALLOWED_ORIGINS=http://localhost:3010

# ===== API 安全 =====
# 啟用 API Key 認證（生產環境建議啟用）
SECURITY_ENABLED=false
# API Key（SECURITY_ENABLED=true 時必填，前端和 Agent 需在請求頭注入 X-API-Key）
API_KEY=

# ===== 缓存 =====
CACHE_SUMMARY_TTL_SECONDS=60
CACHE_METRICS_TTL_SECONDS=30
CACHE_STOCK_TTL_SECONDS=30
CACHE_INDUSTRY_TTL_SECONDS=60
CACHE_FORECAST_TTL_SECONDS=120
CACHE_ROTATION_TTL_SECONDS=120

# ===== 用户偏好 =====
# preference.json 路径（相对路径基于 user.dir，绝对路径直接使用）
PREFERENCE_PATH=preference.json

# ===== 数据同步 (Baostock) =====
# 注意：ingestion-script 路徑相對於項目根目錄。若只拉取 java/ 目錄，
# 數據同步功能不可用（需額外拉取 ingestion/ 目錄）。核心 API 不受影響。
SYNC_PYTHON_EXECUTABLE=python
SYNC_INGESTION_SCRIPT=ingestion/baostock_ingest.py
SYNC_BATCH_SIZE=1000
SYNC_DEFAULT_START_DATE=2021-01-01
SYNC_QUARTERLY_REFRESH=true

# ===== 通知服务 (景氣度預警推送) =====
NOTIFICATION_ENABLED=false
MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=
ALERT_SCHEDULER_ENABLED=false
ALERT_SCHEDULER_THRESHOLD=15.0
ALERT_SCHEDULER_CRON=0 30 15 * * MON-FRI

# ===== AI 調用日誌清理 =====
AICALLLOG_RETENTION_DAYS=90
AICALLLOG_CLEANUP_ENABLED=false
AICALLLOG_CLEANUP_CRON=0 0 2 * * *

# ===== 圖表批次 =====
CHART_BATCH_SIZE=500

# ===== 預測 =====
FORECAST_ADAPTIVE_WEIGHTS=false
FORECAST_ROLLING_WINDOW_DAYS=60
