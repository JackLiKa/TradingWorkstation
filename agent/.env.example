# ===== LLM API Keys =====
# Devin (Cognition) API key — session-based agent API, fallback provider
DEVIN_API_KEY=""

# Qoder Personal Access Token — agent SDK, lightweight provider
QODER_PERSONAL_ACCESS_TOKEN=""

# DeepSeek API key — OpenAI-compatible, 推理最強 (V4-Pro) + 性價比 (V4-Flash)
# 用於 AI 2 策略生成 + AI 3 回測反思（需要深度推理的節點）
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""

# GLM (Zhipu/智譜) API key — OpenAI-compatible, JSON 最穩定 + 免費 Flash
# 用於 AI 0.5 行業分析 + Judge + AI 4 提示詞 + Monitor
# https://open.bigmodel.cn/usercenter/apikeys
GLM_API_KEY=""

# Qwen (Alibaba/通義千問) API key — OpenAI-compatible, 中文金融文本最佳
# 用於 AI 0 行情新聞（中文金融領域訓練數據豐富）
# https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=""

# ===== Backend API =====
# 量化交易後端 REST API 地址（含 /TradingWorkstation 前綴）
BACKEND_API_URL="http://localhost:8090/TradingWorkstation"

# 後端 API Key（若後端啟用 SECURITY_ENABLED=true，此處需填寫對應的 API_KEY）
BACKEND_API_KEY=""

# Agent 服務自身的 API Key（空則跳過認證，生產環境建議設置）
API_KEY=""

# ===== Agent Service =====
# Agent 服務端口
AGENT_PORT=8100

# 優化循環間隔（秒），每輪迭代之間的等待時間
OPTIMIZATION_INTERVAL=5

# 最大迭代次數（0 = 無限制）
MAX_ITERATIONS=0

# ===== 模型檢查 =====
# 模型可用性檢查間隔（秒）
MODEL_CHECK_INTERVAL=300

# ===== 速率限制 =====
# backtest 端點: 每 30 秒 1 次（預設 0.033/s）
RATE_LIMIT_BACKTEST=0.033
# screener 端點: 每 5 秒 1 次（預設 0.2/s）
RATE_LIMIT_SCREENER=0.2
# 讀操作: 每秒 5 次
RATE_LIMIT_READ=5.0

# ===== RAG =====
# 中文 embedding 模型
EMBEDDING_MODEL="BAAI/bge-small-zh-v1.5"
# RAG 檢索返回數量
RAG_TOP_K=3
# RAG 最低相似度閾值
RAG_MIN_SIMILARITY=0.3

# ===== 監控 =====
# 日誌級別: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 是否啟用 Prometheus 指標
ENABLE_METRICS=true

# ===== 環境標識 =====
# development / staging / production
ENVIRONMENT=development

# ===== AI 聊天工具 API Keys =====
# Exa.ai 搜索 API Key — 深度語義搜索，每日 150 次免費額度
# 用於聊天 AI 的深度語義搜索工具（exa_search）
# https://dashboard.exa.ai/api-keys
EXA_API_KEY=""

# 百度千帆 AI 搜索 API Key — 中文資訊與政策檢索
# 用於聊天 AI 的百度搜索工具（baidu_search）
# https://console.bce.baidu.com/qianfan/
BAIDU_QIANFAN_API_KEY=""

# ===== MCP 服務地址 =====
# FTShare MCP 服務地址 — 金融數據查詢（150+ 工具，無需 API Key）
# streamableHttp 協議，默認為 FTShare 公開服務
FTSHARE_MCP_URL="https://market.ft.tech/gateway/mcp"

# a-share-mcp 服務地址 — A股深度歷史數據（基於 Baostock）
# 需本地啟動 a-share-mcp 服務，默認端口 8101
# https://github.com/your/a-share-mcp
A_SHARE_MCP_URL="http://localhost:8101/mcp"
