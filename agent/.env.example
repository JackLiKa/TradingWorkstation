# ===== LLM API Keys =====
# Devin (Cognition) API key — session-based agent API, primary fallback
DEVIN_API_KEY=""

# Qoder Personal Access Token — agent SDK, primary LLM provider
QODER_PERSONAL_ACCESS_TOKEN=""

# ===== Backend API =====
# 量化交易後端 REST API 地址（含 /TradingWorkstation 前綴）
BACKEND_API_URL="http://localhost:8090/TradingWorkstation"

# ===== Agent Service =====
# Agent 服務端口
AGENT_PORT=8100

# 優化循環間隔（秒），每輪迭代之間的等待時間
OPTIMIZATION_INTERVAL=5

# 最大迭代次數（0 = 無限制）
MAX_ITERATIONS=0

# ===== 模型檢查 =====
# 模型可用性檢查間隔（秒）
MODEL_CHECK_INTERVAL=300
