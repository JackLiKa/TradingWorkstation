# 通用 .dockerignore — 減少 Docker build context
# 適用於所有服務目錄

# ===== VCS =====
.git
.gitignore
.gitattributes
.github

# ===== IDE / Editor =====
.vscode
.idea
*.swp
*.swo
*~

# ===== 文檔（不需要進入生產鏡像）=====
*.md
docs/
LICENSE

# ===== 環境配置（敏感）=====
.env
.env.local
.env.*.local
*.env

# ===== 運行時 / 構建產物 =====
__pycache__/
*.pyc
.pytest_cache/
node_modules/
.next/
dist/
build/
target/
*.db
*.sqlite
*.sqlite3
data/
logs/

# ===== OS 文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Docker 自身 =====
Dockerfile
Dockerfile.*
.dockerignore
docker-compose*.yml
