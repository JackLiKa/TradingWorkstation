# Agent .dockerignore — build context 為項目根目錄
# 減少 Docker build context，排除不需要的文件

# ===== VCS =====
.git
.gitignore
.gitattributes
.github

# ===== IDE / Editor =====
.vscode
.idea
*.swp
*.swo
*~

# ===== 文檔（不需要進入生產鏡像）=====
*.md
docs/
LICENSE
NOTICE
CLA
CODE_OF_CONDUCT.md
CONTRIBUTING.md
SECURITY.md

# ===== 環境配置（敏感）=====
.env
.env.local
.env.*.local
*.env

# ===== 運行時 / 構建產物 =====
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
**/.coverage
**/node_modules/
**/.next/
**/dist/
**/build/
**/target/
*.db
*.sqlite
*.sqlite3
agent/data/
agent/logs/

# ===== Docker 自身 =====
**/Dockerfile
**/Dockerfile.*
**/.dockerignore
**/docker-compose*.yml

# ===== 其他服務目錄（不需要進入 agent 鏡像）=====
java/
next/
ingestion/
deploy.sh
deploy-docker.sh
build.sh
docker/
dist/

# ===== a-share-mcp 排除項（保留源碼，排除 .venv 和緩存）=====
a-share-mcp/.venv/
a-share-mcp/.git/
a-share-mcp/.claude/
a-share-mcp/.github/
a-share-mcp/docs/
a-share-mcp/typings/
