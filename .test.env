# 測試環境配置 — CI 和自動化測試用
# 與 .env 分離，避免測試用配置污染開發環境
# 使用: cp .test.env .env（CI 中）或直接設置環境變量

# ===== 數據庫（測試用，可指向 Testcontainers）=====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=test-password
DB_NAME=a_stock_baostock_test

# ===== 後端 =====
SERVER_PORT=8090
SERVER_CONTEXT_PATH=/TradingWorkstation
CACHE_SUMMARY_TTL_SECONDS=0
CACHE_METRICS_TTL_SECONDS=0

# ===== Agent（測試用 mock key）=====
DEVIN_API_KEY=ci-test-key
QODER_PERSONAL_ACCESS_TOKEN=ci-test-token
LOG_LEVEL=WARNING
AGENT_PORT=8100

# ===== 前端 =====
BACKEND_HOST=http://localhost:8090
